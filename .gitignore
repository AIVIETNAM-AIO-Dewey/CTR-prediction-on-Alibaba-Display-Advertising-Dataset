# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Virtual Environments
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
conda-env/

# ==========================================
# Datasets & Data Files (Large files / Raw data)
# ==========================================
data/*
!data/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.zip
*.tar.gz
*.rar
*.7z

# ==========================================
# Trained Models, Checkpoints & Weights
# ==========================================
models/*
!models/.gitkeep
checkpoints/
saved_models/
*.pkl
*.pickle
*.joblib
*.model
*.bin
*.onnx
*.pt
*.pth
*.xgb
*.lgb
*.cbm

# ==========================================
# Logs, Experiment Tracking & Outputs
# ==========================================
logs/
*.log
catboost_info/
mlruns/
wandb/
lightning_logs/
outputs/
results/
reports/figures/*
!reports/figures/.gitkeep

# ==========================================
# Jupyter Notebooks Checkpoints & Scratch
# ==========================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*-checkpoint.ipynb

# ==========================================
# Environment Variables & Local Configs
# ==========================================
.env
.env.local
*.secret.yaml

# ==========================================
# IDEs & Operating System Files
# ==========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
experiments/*
notebook/kaggle_pipeline.ipynb
src/data/*